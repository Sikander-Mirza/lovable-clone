# Any OpenAI-compatible provider works. Default: Google Gemini (free key at aistudio.google.com)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3-flash-preview

# Other options:
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional: Supabase for login + cloud-saved projects (run supabase/schema.sql first).
# Without these the app stores projects in the browser only.
NEXT_PUBLIC_SUPABASE_URL=
# (new projects call this the publishable key; ANON_KEY also works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: "Connect GitHub" / "Connect Vercel" buttons (OAuth). Without these the app
# falls back to pasting a personal access token. See README -> "Connect GitHub and Vercel".
# GitHub OAuth App callback: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Vercel Integration redirect URL: http://localhost:3000/api/auth/vercel/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
# Encrypts the connection cookies (any long random string). Set APP_URL when deployed.
SESSION_SECRET=
APP_URL=http://localhost:3000
